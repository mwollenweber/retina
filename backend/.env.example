# Local dev (docker compose provides these defaults; copy to .env to override)
DJANGO_SETTINGS_MODULE=retina.settings.development
DJANGO_SECRET_KEY=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retina
DB_USER=retina
DB_PASSWORD=retina
# Publishing: leave DATA_BUCKET unset to write frontend/data/cameras.geojson
# DATA_BUCKET=
# DATA_KEY=data/cameras.geojson
# CLOUDFRONT_DISTRIBUTION_ID=
# PUBLISH_FUNCTION_NAME=
